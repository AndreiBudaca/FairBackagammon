<Window x:Class="FairBackgammon.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fair Backgammon (Test UI)" Height="520" Width="900">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Grid.Row="0">
      <Button x:Name="StartNewGameButton" Content="Start New Game" Padding="12,6" Margin="0,0,8,0" Click="StartNewGameButton_OnClick" />
      <Button x:Name="RollButton" Content="Roll" Padding="12,6" Margin="0,0,8,0" Click="RollButton_OnClick" />
      <Button x:Name="MakeFirstMoveButton" Content="Make first move" Padding="12,6" Margin="0,0,8,0" Click="MakeFirstMoveButton_OnClick" />
      <Button x:Name="MakeMoveButton" Content="Make Move" Padding="12,6" Click="MakeMoveButton_OnClick" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="#22000000" BorderThickness="1" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Board" FontWeight="Bold" Margin="0,0,0,8" />

            <UniformGrid x:Name="TopPointsGrid" Columns="12" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" BorderBrush="#22000000" BorderThickness="1" Padding="6" Margin="0,0,6,0">
                <StackPanel>
                  <TextBlock Text="Bar" FontWeight="Bold" Margin="0,0,0,6" />
                  <StackPanel x:Name="BarPanel" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" BorderBrush="#22000000" BorderThickness="1" Padding="6" Margin="6,0,0,0">
                <StackPanel>
                  <TextBlock Text="Bearoff" FontWeight="Bold" Margin="0,0,0,6" />
                  <StackPanel x:Name="BearoffPanel" />
                </StackPanel>
              </Border>
            </Grid>

            <UniformGrid x:Name="BottomPointsGrid" Columns="12" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" Margin="12,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#22000000" BorderThickness="1" Padding="8" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="Valid moves" FontWeight="Bold" Margin="0,0,0,6" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="140">
              <ListBox x:Name="ValidMovesListBox" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding DisplayText}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="ValidMoveCheckBox_OnChecked"
                              Unchecked="ValidMoveCheckBox_OnUnchecked" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <TextBox x:Name="StateTextBox"
                 Grid.Row="1"
                 FontFamily="Consolas"
                 FontSize="14"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#11FFFFFF" BorderBrush="#22000000" BorderThickness="1" Padding="8">
      <TextBlock x:Name="StatusTextBlock" />
    </Border>
  </Grid>
</Window>
